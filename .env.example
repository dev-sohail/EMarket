APP_NAME="Emarket"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe (payment gateway) - set these in Admin > Settings > Payment Methods
STRIPE_ENABLED=
STRIPE_SANDBOX=true
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Inventory
INVENTORY_LOW_STOCK_THRESHOLD=10
INVENTORY_RESERVATION_TTL_MINUTES=10

# Returns
RETURNS_WINDOW_DAYS=30

# Shipping
SHIPPING_DEFAULT_ZONE=

VITE_APP_NAME="${APP_NAME}"

# Timezone - set to your local timezone
TIMEZONE=UTC

# Admin credentials are set during installation, not stored here.
# Keep ADMIN_PASSWORD empty so no real credential is committed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
